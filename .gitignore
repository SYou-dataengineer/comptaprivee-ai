# Environnement Python local
.venv/
venv/

# Fichiers temporaires Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Variables secrètes et configuration locale
.env
.env.*
!.env.example

# Documents confidentiels
data/documents/*
data/exports/*

# Autoriser seulement les fichiers qui conservent les dossiers
!data/documents/.gitkeep
!data/exports/.gitkeep

# Fichiers temporaires et journaux
temp/
tmp/
logs/
*.log

# Fichiers produits par l'OCR
*.ocr.pdf

# VS Code et système d'exploitation
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Bases de données comptables locales
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/profil_comptable.json

# Logo local du cabinet
data/logo_societe.*

# Paramètres locaux de l'application
data/parametres.json
.local_cleanup_archive/
*.bak
